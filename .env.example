# SYNTV RADIO environment variables
# Copy to .env.local for local development. Never commit real secrets.

# --- Redis / shared runtime state ---
# Redis-compatible connection URL for shared listener state, distributed rate limiting,
# contact duplicate protection, and public directory caching across instances.
# Required for production multi-instance deployments (e.g. Vercel + Upstash Redis).
# If unset, safe in-memory fallbacks are used where possible (development/single-instance only).
REDIS_URL=

# --- Listener tracking (real-time active SYNTV RADIO playback sessions) ---

# Session TTL in seconds. Active playback sessions expire without a heartbeat.
LISTENER_SESSION_TTL=90

# Client heartbeat interval in seconds (server TTL must be greater than this).
LISTENER_HEARTBEAT_INTERVAL=25

# Live count update interval in seconds for SSE/polling clients.
LISTENER_UPDATE_INTERVAL=5

# Public directory cache TTL in seconds (station/country/genre directories).
# Configurable; clamped to 30-3600. Redis is used when REDIS_URL is configured.
PUBLIC_CACHE_TTL_SECONDS=300

# Admin analytics token. Required to access /admin/listeners and /api/listeners/admin.
# Use a long random secret. Do not commit the real value.
LISTENER_ADMIN_TOKEN=

# --- SEO verification (optional) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Public contact address for legal/information pages ---
# Placeholder is contact@syntv.online. Set this to the real, monitored inbox
# before publishing the privacy policy or applying for AdSense.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Contact delivery (choose webhook OR Resend; webhook takes precedence) ---
# Without one valid provider configuration, POST /api/contact returns 503
# contact_not_configured and no message is stored or sent.
# Webhook URL must be absolute HTTP(S); private hosts are rejected in production.
CONTACT_WEBHOOK_URL=
# Optional bearer token. Send only over HTTPS and never commit the real value.
CONTACT_WEBHOOK_SECRET=
# Resend is used only when CONTACT_WEBHOOK_URL is empty.
# CONTACT_FROM_EMAIL must be a verified sender in Resend after domain verification.
# Leave these blank until the mailbox and sender are verified. After verification,
# the official addresses are: SYNTV RADIO <hello@syntv.online> and hello@syntv.online.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Server-only publication gate. Set true only after the mailbox is configured,
# verified with the provider, and confirmed to receive a test message. The email
# is hidden from every public page until this is true AND a delivery setting
# above references hello@syntv.online.
CONTACT_EMAIL_VERIFIED=false

# --- Google AdSense (advertising stays disabled by default) ---
# Public publisher ID. This is not a secret; it is also the verified code default.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-6652257842391620
# Real numeric slot IDs from the AdSense account. Leave blank until created;
# no placeholders or invented IDs are rendered.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=
NEXT_PUBLIC_ADSENSE_SLOT_DETAIL=
# Server-only master switch. Ads do not load unless this is true.
ADS_ENABLED=false
# Server-only owner attestation. Set true only after a Google-certified CMP has
# been configured, published, and verified in the AdSense account. This flag is
# not proof of compliance by itself.
ADS_CMP_VERIFIED=false

# --- Admin / Database (persistent, required for production admin features) ---
# PostgreSQL connection string. Required for admin auth, RBAC, station CRUD,
# contact submission management, stream health history, SEO metadata, ad config, and audit logs.
# Do not use JSON files or in-memory state as production multi-instance admin storage.
DATABASE_URL=
# Direct/unpooled connection string for Prisma migrations (Neon: DATABASE_URL_UNPOOLED).
DATABASE_URL_UNPOOLED=

# Optional: bootstrap first owner on first login setup script/runbook (see README).
# Do not commit real credentials.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
