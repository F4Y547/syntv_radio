generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum AdminRole {
  owner
  administrator
  editor
}

enum SubmissionStatus {
  NEW
  READ
  IN_PROGRESS
  REPLIED
  ARCHIVED
  SPAM
}

enum ContactPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ContactReplyStatus {
  PENDING
  SENT
  FAILED
}

enum StationApprovalStatus {
  pending
  approved
  rejected
}

model AdminUser {
  id                   String              @id @default(cuid())
  email                String              @unique
  name                 String?
  passwordHash         String
  role                 AdminRole           @default(editor)
  active               Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  sessions             AdminSession[]
  auditLogs            AuditLog[]          @relation("AuditActor")
  assignedContacts     ContactSubmission[] @relation("AssignedContactSubmissions")
  contactReplies       ContactReply[]      @relation("ContactReplyActor")
  contactNotes         ContactNote[]       @relation("ContactNoteAuthor")
  contactActivities    ContactActivity[]   @relation("ContactActivityActor")
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  csrfToken String    @default("")
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model Station {
  id          String                @id @default(cuid())
  externalId  String?               @unique // Radio Browser UUID if linked
  name        String
  streamUrl   String
  homepage    String?
  favicon     String?
  country     String?
  countryCode String?
  state       String?
  language    String?
  tags        String[]              @default([])
  codec       String?
  bitrate     Int?
  description String?
  isActive    Boolean               @default(true)
  isFeatured  Boolean               @default(false)
  isVerified  Boolean               @default(false)
  approvalStatus StationApprovalStatus @default(approved)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  healthChecks StreamHealthCheck[]

  @@index([name])
  @@index([countryCode])
  @@index([approvalStatus])
}

model Country {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Genre {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id           String           @id @default(cuid())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  name         String
  email        String
  topic        String
  station      String?
  message      String
  status       SubmissionStatus @default(NEW)
  priority     ContactPriority  @default(NORMAL)
  assignedToId String?
  assignedTo   AdminUser?       @relation("AssignedContactSubmissions", fields: [assignedToId], references: [id], onDelete: SetNull)
  readAt       DateTime?
  repliedAt    DateTime?
  archivedAt   DateTime?
  spamAt       DateTime?
  ip           String?
  userAgent    String?
  delivery     String           @default("accepted")
  notes        String?          // legacy plain notes; prefer ContactNote
  replies      ContactReply[]
  contactNotes ContactNote[]
  activities   ContactActivity[]

  @@index([status, createdAt])
  @@index([priority, createdAt])
  @@index([assignedToId, createdAt])
  @@index([email])
  @@index([createdAt])
}

model ContactReply {
  id                String             @id @default(cuid())
  submissionId      String
  submission        ContactSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actorId           String?
  actor             AdminUser?         @relation("ContactReplyActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail        String?
  toEmail           String
  subject           String
  bodyText          String
  bodyHtml          String?
  provider          String             @default("resend")
  providerMessageId String?
  status            ContactReplyStatus @default(PENDING)
  error             String?
  sentAt            DateTime?
  createdAt         DateTime           @default(now())

  @@index([submissionId, createdAt])
  @@index([actorId])
}

model ContactNote {
  id           String            @id @default(cuid())
  submissionId String
  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId     String?
  author       AdminUser?        @relation("ContactNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorEmail  String?
  body         String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([submissionId, createdAt])
  @@index([authorId])
}

model ContactActivity {
  id           String            @id @default(cuid())
  submissionId String
  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actorId      String?
  actor        AdminUser?        @relation("ContactActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail   String?
  type         String
  detail       Json?
  createdAt    DateTime          @default(now())

  @@index([submissionId, createdAt])
  @@index([type])
}

model StreamHealthCheck {
  id          String   @id @default(cuid())
  stationId   String?
  station     Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  streamUrl   String
  ok          Boolean
  statusCode  Int?
  contentType String?
  latencyMs   Int?
  error       String?
  checkedAt   DateTime @default(now())
  checkedBy   String?

  @@index([stationId, checkedAt])
  @@index([checkedAt])
}

model SeoMetadata {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String?
  description String?
  canonical   String?
  ogImage     String?
  noindex     Boolean  @default(false)
  structuredData Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

model AdConfig {
  id              String   @id @default(cuid())
  key             String   @unique @default("default")
  enabled         Boolean  @default(false)
  cmpVerified     Boolean  @default(false)
  publisherId     String?
  homeSlot        String?
  listingSlot     String?
  detailSlot      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?
}

model AuditLog {
  id        String     @id @default(cuid())
  at        DateTime   @default(now())
  actorId   String?
  actor     AdminUser? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action    String
  targetType String?
  targetId  String?
  detail    Json?
  ip        String?

  @@index([at])
  @@index([actorId])
  @@index([action])
}
